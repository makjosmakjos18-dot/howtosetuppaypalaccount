{
  "provider": "admob",
  "is_ads_enabled": false,
  "test_mode": false,

  "is_banner_enabled": false,
  "is_interstitial_enabled": true,
  "is_app_open_enabled": true,
  "is_rewarded_enabled": true,
  "is_native_enabled": true,

  "interstitial_interval_seconds": 60,
  "interstitial_clicks_threshold": 3,

  "app_open_interval_seconds": 60,
  "show_app_open_on_start": true,
  "show_app_open_on_resume": true,

  "preload_ads": true
}
